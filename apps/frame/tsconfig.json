{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../web/*"],
      "@haveabreak/frame/*": ["./*"],
      "@haveabreak/ui/*": ["../../packages/ui/*"],
      "@haveabreak/utils/*": ["../../packages/utils/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/ui/**/*",
    "../../packages/utils/**/*"
  ],
  "exclude": ["node_modules"]
}
